#!name=Apple WLOC Location Spoofer
#!desc=Modify the coordinates returned by Apple's network-based location service (WiFi/cell) | Shortcuts (recommended): Set Location https://www.icloud.com/shortcuts/096685588ca14583b01908957219b626 Clear Location https://www.icloud.com/shortcuts/cd0c9258d08f45c1a075ca5fe85a8387 | Picker page: https://wloc-spoofer-en.1169139588.workers.dev/
#!author=Yu9191 Rewrite
#!homepage=https://github.com/paomian1hao/wloc-spoofer-en
#!category=Tools
#!arguments=longitude:113.94114, latitude:22.544577, accuracy:25, logLevel:info
#!arguments-desc=longitude/latitude: default coordinates (a saved online-picker location takes priority)\naccuracy: GPS accuracy (meters)\nlogLevel: off/error/warn/info/debug/all\n\nUsage: open the picker page -> choose a location -> Save to Device

[Script]
Apple WLOC = type=http-response, pattern="^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc", requires-body=1, binary-body-mode=1, max-size=0, timeout=30, script-path=https://raw.githubusercontent.com/paomian1hao/wloc-spoofer-en/refs/heads/main/dist/wloc.js, argument=longitude={{{longitude}}}&latitude={{{latitude}}}&accuracy={{{accuracy}}}&logLevel={{{logLevel}}}
WLOC Settings = type=http-request, pattern="^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save", requires-body=0, max-size=0, timeout=10, script-path=https://raw.githubusercontent.com/paomian1hao/wloc-spoofer-en/refs/heads/main/dist/wloc-settings.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com
